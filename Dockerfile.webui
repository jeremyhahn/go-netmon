# Build stage
FROM golang:1.27.0-alpine AS builder

# Install build dependencies including libsmi for gosmi MIB parsing
RUN apk add --no-cache git make gcc musl-dev libsmi libsmi-dev

# Set working directory
WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the Web UI application with CGO enabled for gosmi
RUN CGO_ENABLED=1 go build -o ./bin/webui ./cmd/webui

# Runtime stage
FROM alpine:latest

# Install runtime dependencies including libsmi and standard MIBs for MIB parsing
RUN apk add --no-cache ca-certificates tzdata curl libsmi net-snmp-libs

# Set SMIPATH environment variable to include our MIB directories
ENV SMIPATH=/app/data/mibs/uploaded:/app/mibs/standard:/usr/share/snmp/mibs

# Create non-root user
RUN addgroup -g 1000 netmon && \
    adduser -D -u 1000 -G netmon netmon

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/bin/webui /app/webui

# Copy static files
COPY --from=builder /build/internal/webui/static /app/internal/webui/static

# Copy MIBs directory (for MIB loader initialization)
# Only the IETF standard modules are baked in. They are the base every SNMP
# deployment needs before it can parse anything, so a fresh container can
# bootstrap with an empty volume.
#
# The device-specific trees (asr1001, cisco, r640, vendor) are NOT shipped: they
# are 20 MB of one site's equipment, they are testdata for the parser rather
# than a runtime dependency, and baking them in put a module on the search path
# that no backup covered and no operator had imported. Device MIBs arrive by
# import or restore, and are then held in the volume.
COPY --from=builder /build/mibs/standard /app/mibs/standard

# Create directories for config and data (including webui subdirectory for volume mount)
RUN mkdir -p /app/config /app/data /app/data/mibs /app/data/webui && \
    chown -R netmon:netmon /app

# Switch to non-root user
USER netmon

# Expose Web UI port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/ || exit 1

# Run the Web UI application
ENTRYPOINT ["/app/webui"]
