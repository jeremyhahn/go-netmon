# Pinned to the digest, and it must stay equal to Dockerfile.helper's
# HELPER_BASE default. The helper is derived from this base precisely so that it
# adds no artifact the suite did not already need; if the two drift apart the
# host pulls two images instead of one, and that claim quietly stops holding.
FROM golang:1.27.3-alpine@sha256:f2c872bcee949b7be9c490efd02b48a8a2fbf947cdf533f1c58525ec9d8170fd

# Install dependencies including net-snmp for snmptranslate.
#
# docker-cli is here for the backup/restore tests, which drive a real daemon.
# That daemon is the sibling "dind" service, not the host's: this container is
# unprivileged and has no access to the host socket, so a backup test cannot
# reach the deployment it is testing a backup of.
RUN apk add --no-cache git make bash curl net-snmp net-snmp-tools docker-cli docker-cli-compose

# Set working directory
WORKDIR /workspace

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy the entire project
COPY . .

# Compile the whole tree under the integration tag, so the image build fails on
# a tagged file that does not compile.
#
# This replaces "go test -c -tags=integration ./test/integration": that compiled
# ONE package, so internal/mib/parser's tagged file went uncompiled for months
# while every check stayed green, because go build, go vet and go test are all
# scoped to the tag set they are given (#30). vet over ./... under the tag is
# the whole matrix -- integration is the repository's only build tag.
RUN go vet -tags=integration ./...

# Default command runs every package holding integration-tagged tests, not one
# named directory. See test/integration/tagged-packages.sh.
CMD ["bash", "-c", "go test -v -tags=integration $(test/integration/tagged-packages.sh)"]
