FROM golang:1.26-alpine

# Install dependencies including net-snmp for snmptranslate.
#
# docker-cli is here for the backup/restore tests, which drive a real daemon.
# That daemon is the sibling "dind" service, not the host's: this container is
# unprivileged and has no access to the host socket, so a backup test cannot
# reach the deployment it is testing a backup of.
RUN apk add --no-cache git make bash curl net-snmp net-snmp-tools docker-cli docker-cli-compose

# Set working directory
WORKDIR /workspace

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy the entire project
COPY . .

# Build the test binary. The integration build tag is required: integration_test.go
# carries it, so without the tag the package compiles to the tests that need no
# services at all and the end-to-end test is silently left out.
RUN go test -c -tags=integration ./test/integration -o /integration-test

# Default command runs all integration tests
CMD ["go", "test", "-v", "-tags=integration", "./test/integration"]
