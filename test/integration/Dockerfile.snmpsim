# SNMP simulator for the integration stack with its recording baked in, since bind mounts resolve on the daemon's filesystem.
FROM tandrup/snmpsim:latest

COPY test/integration/snmp-data/public.snmprec /usr/local/snmpsim/data/public.snmprec
# The e2e stack's second device, served under community "second".
COPY test/integration/snmp-data/second.snmprec /usr/local/snmpsim/data/second.snmprec
