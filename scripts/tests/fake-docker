#!/usr/bin/env bash
# A stub Docker CLI backed by a directory tree, used by scripts/tests/run-tests.sh.
#
# The backup and restore scripts route every Docker call through $DOCKER, so
# pointing that at this stub exercises their real logic - argument handling,
# ownership checks, manifest generation, integrity verification, the restore
# gates - with no Docker daemon and, critically, no possibility of touching a
# live stack.
#
# State lives under $FAKE_DOCKER_ROOT:
#
#   volumes/<name>/data/...   volume contents
#   volumes/<name>/project    compose project label (absent = unlabelled)
#   running                   services currently "running"
#   containers                one per line:
#                             "<id> <project> <config_files> [running|exited]"
#                             The state defaults to "running" when omitted. It
#                             exists because "docker ps" WITHOUT -a shows only
#                             running containers, and a stopped foreign
#                             container is still a foreign container.
#   ps-status                 if present, "docker ps" fails with this exit code
#   inspect-status            if present, "docker inspect" fails with this code
#   compose-volumes           logical volume names the compose file defines
#   services.json             compose service -> image mapping
#   images                    images this daemon has, one per line; a name not
#                             listed is reported missing, exactly as a real
#                             daemon does, which is what makes ImageID's
#                             empty-id branch reachable
#   log                       every invocation, for assertions about behaviour

set -euo pipefail

root="${FAKE_DOCKER_ROOT:?FAKE_DOCKER_ROOT must be set}"
mkdir -p "$root"
printf '%s\n' "$*" >>"$root/log"

vol_dir() { printf '%s/volumes/%s/data' "$root" "$1"; }

# ps_filter validates one "docker ps" filter VALUE and records it. Exactly one
# shape is understood; everything else is fatal, including docker's negated
# label spelling, which a real daemon parses as a literal value and matches
# nothing with. Silence there is what let the original defect through.
ps_filter() {
    case "$1" in
        "label=com.docker.compose.project="*)
            # A second project filter is a CONFLICT, not an override. Silently
            # keeping the last one means a query with two filters gets an
            # answer decided by argument order -- the same "dropped filter"
            # family this stub exists to refuse.
            if [ -n "${ps_want_project:-}" ]; then
                die "ps: two project filters given ('$ps_want_project' then '${1#label=com.docker.compose.project=}'); docker would apply both and match neither"
            fi
            ps_want_project="${1#label=com.docker.compose.project=}" ;;
        *)
            die "unsupported ps filter '$1'. This stub understands only
  label=com.docker.compose.project=<name>. Docker has no negated label filter,
  and a mistyped label key matches nothing on a real daemon -- both look like
  'no foreign containers' to a caller." ;;
    esac
}

# compose_ps_filter validates one "docker compose ps --filter" VALUE. Exactly
# one key is understood; everything else is fatal for the same reason the
# top-level ps arm refuses -- a filter this stub drops is a filter the caller
# believes it applied.
#
# The "have we seen one" flag is SEPARATE from the value. Using the empty
# string for both meant "--filter status=" parsed to empty, did not count as
# seen, and let a second filter through the duplicate check -- an unset
# sentinel that a legal input can forge.
compose_ps_status=""
compose_ps_status_seen=0
compose_ps_filter() {
    case "$1" in
        "status="*)
            [ "$compose_ps_status_seen" -eq 0 ] || die "compose ps: two status filters given ('$compose_ps_status' then '${1#status=}')"
            compose_ps_status_seen=1
            compose_ps_status="${1#status=}" ;;
        *) die "unsupported 'compose ps' filter '$1'. This stub understands only
  status=<state>." ;;
    esac
}

# compose_require_services refuses an empty service list and any name the
# compose file does not define. Shared by "stop" and "start" so the two cannot
# drift: they were asymmetric once already, stop validating and start not.
compose_require_services() {
    local verb="$1"
    shift
    [ "$#" -gt 0 ] || die "compose $verb: no services named. The tooling always names what it
  acts on, and the whole-project form is not a shape it issues, so this stub
  refuses rather than guessing which was meant."
    local want known line
    for want in "$@"; do
        known=0
        while read -r line; do
            [ "$line" = "$want" ] && known=1
        done < <(jq -r '.services | keys[]' "$root/services.json")
        [ "$known" -eq 1 ] || die "compose $verb: no such service '$want' in this compose file.
  Real compose fails here; answering anyway would let an operation on a service
  that does not exist read as a successful one."
    done
}

die() {
    printf 'fake-docker: %s\n' "$*" >&2
    exit 1
}


# --- docker compose -------------------------------------------------------

cmd_compose() {
    local project="" file="" args=()
    while [ $# -gt 0 ]; do
        case "$1" in
        -p)
            project="$2"
            shift 2
            ;;
        -f)
            file="$2"
            shift 2
            ;;
        *)
            args+=("$1")
            shift
            ;;
        esac
    done
    # -p AND -f ARE REQUIRED for every arm that reads or mutates project state.
    # They were parsed and then discarded with a ": " no-op, so the stub
    # answered "config" and "ps", and acted on "stop" and "up", for an
    # invocation that named no project and no compose file at all. Production
    # pins both on every call (netmon-stack.sh compose()), so a regression that
    # dropped one would have been answered here exactly as if it had not.
    # "compose version" is the one arm production issues unscoped.
    case "${args[0]:-}" in
    version) : ;;
    *)
        [ -n "$project" ] || die "compose ${args[0]:-<none>}: no -p project given. Every compose call the
  tooling makes pins the project; answering an unscoped one would let a dropped
  -p read exactly like a correct call."
        [ -n "$file" ] || die "compose ${args[0]:-<none>}: no -f compose file given. Same reason as -p:
  a compose file this stub does not require is one the caller can drop without
  the tests noticing." ;;
    esac

    case "${args[0]:-}" in
    version)
        # An unrecognised flag used to fall through to the long form, so a
        # caller asking for something this stub does not model got an answer
        # anyway. And it is VALIDATED BEFORE ANYTHING IS PRINTED: the
        # extra-argument check first ran after the output, so
        # "compose version --short junk" emitted the version AND then failed --
        # and a caller spelled "$(... || echo unknown)" captures both.
        [ "${#args[@]}" -le 2 ] || die "unsupported extra 'compose version' arguments: ${args[*]:2}"
        case "${args[1]:-}" in
        '')       printf 'Docker Compose version 2.40.3\n' ;;
        --short)  printf '2.40.3\n' ;;
        *)        die "unsupported 'compose version' argument '${args[1]}'" ;;
        esac
        ;;
    config)
        # "--format" used to be honoured without reading its VALUE, so
        # "config --format yaml" returned JSON.
        case "${args[1]:-}" in
        --volumes)
            [ "${#args[@]}" -le 2 ] || die "unsupported extra 'compose config --volumes' arguments: ${args[*]:2}"
            cat "$root/compose-volumes" ;;
        --format)
            [ "${args[2]:-}" = "json" ] || die "unsupported 'compose config --format' value '${args[2]:-<none>}';
  this stub renders JSON only"
            [ "${#args[@]}" -le 3 ] || die "unsupported extra 'compose config --format' arguments: ${args[*]:3}"
            cat "$root/services.json" ;;
        *) die "unsupported compose config: ${args[*]}" ;;
        esac
        ;;
    ps)
        # READS ITS FILTER. It used to cat the running set whatever it was
        # asked, so "--filter status=running" was decorative: a regression to
        # "status=exited", or to no filter at all, returned the running
        # services and every test still passed. Same shape as the ps-filter
        # defect the ownership check shipped three times.
        local cps_services=0 cps_status="" cps_i=1 cps_expect=0
        while [ "$cps_i" -lt "${#args[@]}" ]; do
            if [ "$cps_expect" -eq 1 ]; then
                compose_ps_filter "${args[$cps_i]}"
                cps_expect=0
                cps_i=$((cps_i + 1))
                continue
            fi
            case "${args[$cps_i]}" in
            --services)  cps_services=1 ;;
            --filter)    cps_expect=1 ;;
            --filter=*)  compose_ps_filter "${args[$cps_i]#--filter=}" ;;
            *) die "unsupported 'compose ps' argument '${args[$cps_i]}'. This stub
  understands --services and a status filter. Anything else is refused rather
  than ignored: an argument this stub drops is one the code under test believes
  it applied." ;;
            esac
            cps_i=$((cps_i + 1))
        done
        [ "$cps_expect" -eq 0 ] || die "compose ps: --filter was given with no value"
        [ "$cps_services" -eq 1 ] || die "compose ps: this stub models only the --services listing"
        cps_status="$compose_ps_status"
        case "$cps_status" in
        running) cat "$root/running" 2>/dev/null || true ;;
        "") die "compose ps: no status filter given; this stub refuses to answer an
  unfiltered listing, because the caller that drops its filter gets the same
  answer as the caller that keeps it" ;;
        *) die "unsupported 'compose ps' status filter '$cps_status'; this stub models
  only status=running" ;;
        esac
        ;;
    stop)
        # STOPS ONLY THE SERVICES NAMED. It used to truncate the running set
        # whatever it was handed, so a regression that stopped the wrong subset
        # -- or all four when it meant two -- was invisible. restore.sh stops a
        # subset and restarts exactly that subset; the difference is an outage.
        local cs_services=() cs_svc cs_hit cs_keep=()
        cs_services=("${args[@]:1}")
        compose_require_services stop "${cs_services[@]}"
        while read -r cs_svc; do
            [ -n "$cs_svc" ] || continue
            cs_hit=0
            for cs_known in "${cs_services[@]}"; do
                [ "$cs_known" = "$cs_svc" ] && cs_hit=1
            done
            [ "$cs_hit" -eq 1 ] || cs_keep+=("$cs_svc")
        done <"$root/running"
        if [ "${#cs_keep[@]}" -gt 0 ]; then
            printf '%s\n' "${cs_keep[@]}" >"$root/running"
        else
            : >"$root/running"
        fi
        printf 'stopped\n' >>"$root/actions"
        ;;
    start)
        # VALIDATED LIKE stop, and for the same reason. This arm wrote whatever
        # followed "start" straight into the running set and reported success,
        # so "compose start bogus" invented a running service that the compose
        # file does not define -- and every later assertion about what is
        # running was then made against a fiction. It was missed in the first
        # enumeration precisely because it DOES read its argument: reading one
        # and validating it are different things, and stop had been given the
        # check while start had not.
        local start_services=()
        start_services=("${args[@]:1}")
        compose_require_services start "${start_services[@]}"
        printf '%s\n' "${start_services[@]}" >"$root/running"
        printf 'started\n' >>"$root/actions"
        ;;
    up)
        # "up --no-start" materialises volumes; "up -d" starts everything.
        #
        # VALIDATED BEFORE ANYTHING IS CREATED. Anything that was not
        # --no-start used to mean "start everything", so an unmodelled flag
        # silently started the stack -- and the first version of that check ran
        # AFTER the volumes had already been materialised, so a refused
        # invocation still left the fixture mutated. A stub that refuses after
        # acting has not refused.
        case "${args[1]:-}" in
        --no-start|-d) : ;;
        *) die "unsupported 'compose up' argument '${args[1]:-<none>}'; this stub models
  --no-start and -d" ;;
        esac
        [ "${#args[@]}" -le 2 ] || die "unsupported extra 'compose up' arguments: ${args[*]:2}"

        local name
        while read -r name; do
            [ -z "$name" ] && continue
            mkdir -p "$(vol_dir "${project}_${name}")"
            printf '%s' "$project" >"$root/volumes/${project}_${name}/project"
        done <"$root/compose-volumes"
        if [ "${args[1]:-}" != "--no-start" ]; then
            jq -r '.services | keys[]' "$root/services.json" >"$root/running"
            printf 'up\n' >>"$root/actions"
        fi
        ;;
    *) die "unsupported compose command: ${args[*]}" ;;
    esac
}

# --- docker run -----------------------------------------------------------

# PARSES THE INVOCATION AND DISPATCHES ON WHAT IT SAYS, not on a substring of
# the whole argv.
#
# The previous version resolved only the volume NAME from the first -v and then
# matched a marker anywhere in "$*", so every other thing the invocation said
# was ignored: the mount TARGET (/src vs /dst), :ro, --network none, --rm, -i,
# and the helper image. Each of those is present deliberately, and each could
# have been dropped or changed without a single test noticing -- including the
# read-only mount that exists so a bug cannot write back through the export
# path, and the pinned image that keeps a backup and the restore after it
# agreeing about tar. Matching anywhere in the argv was worse still: the marker
# could occur in a volume name or an image tag and still select the branch.
#
# So: the flags are parsed exhaustively, the mount is resolved as
# name:target[:opts], the container command is compared verbatim, and the
# argv each shape REQUIRES is asserted against the shape it claims to be.
# Anything else is fatal. Same rule as the ps, inspect and compose arms.

# run_shape names the operation an exact container command performs, or nothing
# if the command is not one the tooling issues. The three are, verbatim, from
# netmon-stack.sh's volume_bytes, volume_export and volume_import.
run_shape() {
    case "$*" in
    "sh -c du -sb /src 2>/dev/null | cut -f1")                            printf 'size' ;;
    "tar -C /src --numeric-owner -cf - .")                                printf 'export' ;;
    "sh -c find /dst -mindepth 1 -delete && tar -C /dst --numeric-owner -xf -") printf 'import' ;;
    esac
}

cmd_run() {
    local rm=0 interactive=0 network="" mount="" image=""

    while [ $# -gt 0 ]; do
        case "$1" in
        --rm) rm=1; shift ;;
        -i | --interactive) interactive=1; shift ;;
        --network) network="${2-}"; shift 2 ;;
        --network=*) network="${1#--network=}"; shift ;;
        -v | --volume)
            [ -z "$mount" ] || die "run: two -v mounts given ('$mount' then '${2-}').
  The tooling mounts exactly one volume per helper container; a second mount is
  a shape this stub does not model."
            mount="${2-}"
            shift 2
            ;;
        --volume=*)
            [ -z "$mount" ] || die "run: two -v mounts given ('$mount' then '${1#--volume=}')"
            mount="${1#--volume=}"
            shift
            ;;
        -*)
            die "unsupported 'run' option '$1'. This stub understands --rm, -i,
  --network and -v. A flag it ignores is a flag the caller believes it passed --
  which is how --network none and :ro went unmodelled here for as long as they
  did." ;;
        *) image="$1"; shift; break ;;
        esac
    done

    [ -n "$image" ] || die "run: no image named"
    [ "$#" -gt 0 ] || die "run: no container command given"

    # --- what every helper container must say ---------------------------

    [ "$rm" -eq 1 ] || die "run: no --rm. Every helper container the tooling starts is
  disposable; one that is not leaks a container per volume per backup."
    [ "$network" = none ] || die "run: --network is '${network:-<none>}', want 'none'. The helper
  containers stream volume data and must not be able to reach a network at all."
    : "${NETMON_HELPER_IMAGE:?run: NETMON_HELPER_IMAGE is unset, so this stub cannot say
  which image the tooling is pinned to. Refusing rather than accepting whatever
  it was handed.}"
    [ "$image" = "$NETMON_HELPER_IMAGE" ] || die "run: image '$image', want the pinned
  '\$NETMON_HELPER_IMAGE' ($NETMON_HELPER_IMAGE). A backup and the restore that
  follows it must not disagree about tar."

    # --- the mount, as name:target[:opts] --------------------------------

    [ -n "$mount" ] || die "run: no -v mount given"
    local vol target opts rest dir
    vol="${mount%%:*}"
    rest="${mount#*:}"
    [ "$rest" != "$mount" ] || die "run: -v '$mount' names no target. Docker takes
  name:target[:opts]; a bare name is an anonymous volume, not this mount."
    target="${rest%%:*}"
    opts=""
    [ "${rest#*:}" = "$rest" ] || opts="${rest#*:}"

    dir="$(vol_dir "$vol")"
    [ -d "$dir" ] || die "no such volume: $vol"

    # --- the shape, and the argv it requires -----------------------------

    local shape
    shape="$(run_shape "$@")"
    [ -n "$shape" ] || die "unsupported run command: $*. This stub matches the three
  the tooling issues, verbatim: the du size probe, the tar export and the
  find-and-untar import. A command matched by substring is one whose difference
  from the real thing nobody looked at."

    case "$shape" in
    size | export)
        [ "$target" = /src ] || die "run: the $shape reads the volume, so it must be mounted at
  /src; this one mounts it at '$target'."
        [ "$opts" = ro ] || die "run: the $shape mounts '$vol' with options '${opts:-<none>}',
  want 'ro'. The export path is read-only precisely so a bug cannot write back
  through it; without it that guarantee is gone and nothing says so."
        [ "$interactive" -eq 0 ] || die "run: the $shape takes no stdin, so -i is a shape this
  stub does not model."
        ;;
    import)
        [ "$target" = /dst ] || die "run: the import writes the volume, so it must be mounted
  at /dst; this one mounts it at '$target'."
        [ -z "$opts" ] || die "run: the import mounts '$vol' with options '$opts'. It has to
  write, and a read-only import fails inside the container where the caller
  cannot see it."
        [ "$interactive" -eq 1 ] || die "run: the import reads the archive from stdin and no -i
  was given. Without it the container gets no stdin, tar reads EOF, and the
  volume is emptied and left empty -- a restore that destroys data and reports
  success."
        ;;
    esac

    case "$shape" in
    size)   du -sb "$dir" | cut -f1 ;;
    export) tar -C "$dir" --numeric-owner -cf - . ;;
    import)
        find "$dir" -mindepth 1 -delete
        tar -C "$dir" --numeric-owner -xf -
        ;;
    esac
}

# --- docker volume --------------------------------------------------------

cmd_volume() {
    case "${1:-}" in
    inspect)
        shift
        local fmt="" names=()
        while [ $# -gt 0 ]; do
            case "$1" in
            --format)
                fmt="$2"
                shift 2
                ;;
            *)
                names+=("$1")
                shift
                ;;
            esac
        done
        # THE TEMPLATE'S CONTENT DECIDES THE ANSWER. This used to test only
        # "is a format set" and then print the project label whatever it said,
        # so a production change to the template -- to a label key that does
        # not exist, which real docker answers EMPTY -- was undetectable. Same
        # defect the inspect arm carried, one command over.
        #
        # No --format at all is the existence check: exit 0 if the volume is
        # there, non-zero if it is not, and no output either way.
        case "$fmt" in
            ''|'{{index .Labels "com.docker.compose.project"}}') : ;;
            *) die "unsupported 'volume inspect --format' template: $fmt. This stub
  answers exactly one, the compose project label. A label key that does not
  exist returns EMPTY on a real daemon, which is not what answering anyway
  would produce." ;;
        esac
        # NO NAMES IS AN ERROR. With an empty list the loop simply did not run
        # and the arm exited 0 -- a query that named nothing got a successful
        # answer, which real docker does not give.
        [ "${#names[@]}" -gt 0 ] || die "volume inspect: no volume named"
        local n
        for n in "${names[@]}"; do
            [ -d "$(vol_dir "$n")" ] || die "no such volume: $n"
            if [ -n "$fmt" ]; then
                cat "$root/volumes/$n/project" 2>/dev/null || true
                printf '\n'
            fi
        done
        ;;
    ls)
        # READS THE TEMPLATE. It used to list directory names whatever it was
        # asked, so "--format '{{.Name}}'" was decorative.
        shift
        local lsfmt=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --format)   lsfmt="${2:-}"; shift 2 ;;
                --format=*) lsfmt="${1#--format=}"; shift ;;
                *)          die "unsupported 'volume ls' argument '$1'" ;;
            esac
        done
        [ "$lsfmt" = '{{.Name}}' ] || die "unsupported 'volume ls --format' template: ${lsfmt:-<none>}.
  This stub answers exactly one, {{.Name}} -- a bare listing prints a table
  with a header on a real daemon, which is not what this returns."
        ls -1 "$root/volumes" 2>/dev/null || true
        ;;
    *) die "unsupported volume command: $*" ;;
    esac
}

# --- entry point ----------------------------------------------------------

case "${1:-}" in
compose)
    shift
    cmd_compose "$@"
    ;;
run)
    shift
    cmd_run "$@"
    ;;
volume)
    shift
    cmd_volume "$@"
    ;;
ps)
    # A forced failure, for the fail-open case: a query that could not be
    # answered must never be read as "nothing foreign".
    if [ -f "$root/ps-status" ]; then
        printf 'Cannot connect to the Docker daemon\n' >&2
        exit "$(cat "$root/ps-status")"
    fi

    # MODELS CONTAINERS AND THEIR LABELS, and REFUSES EVERY ARGV IT DOES NOT
    # UNDERSTAND.
    #
    # Three versions of this, each less wrong than the last:
    #
    #  1. It returned the contents of a "foreign" file whatever filter it was
    #     handed, so it could not tell a correct ownership query from a
    #     malformed one -- and the code under test used "label=KEY!=VALUE",
    #     which a real daemon matches nothing with. Two tests asserted the
    #     ownership check refuses foreign containers, and passed, against a
    #     function that could never refuse.
    #  2. It recognised the good filter and let anything unrecognised fall
    #     through to MATCH-ALL, so a check regressed to a typo in the label key
    #     still saw every container and the tests still passed.
    #  3. It recognised only "--filter" and silently ignored "-f" -- docker's
    #     own alias for it, "-f, --filter filter" in docker ps --help. A bad
    #     filter spelled with -f was dropped while a good --filter still
    #     returned matches, so the tests passed against a malformed query
    #     again. Same defect, third spelling.
    #
    # So argv is parsed exhaustively and anything unrecognised is fatal. The
    # cost is that a test needing a new query shape must teach this stub about
    # it, and that cost IS the mechanism: it is the moment somebody checks the
    # shape is one docker honours.
    shift
    ps_want_project=""
    ps_quiet=0
    ps_all=0
    ps_expect_filter=0
    while [ $# -gt 0 ]; do
        if [ "$ps_expect_filter" -eq 1 ]; then
            ps_filter "$1"
            ps_expect_filter=0
            shift
            continue
        fi
        case "$1" in
            -aq|-qa)     ps_quiet=1; ps_all=1 ;;
            -a|--all)    ps_all=1 ;;
            -q|--quiet)  ps_quiet=1 ;;
            --filter|-f) ps_expect_filter=1 ;;
            --filter=*)  ps_filter "${1#--filter=}" ;;
            -f=*)        ps_filter "${1#-f=}" ;;
            *)
                die "unsupported 'ps' argument '$1'. This stub understands -a, -q,
  -aq, --all, --quiet and a project filter via --filter or -f. Anything else is
  refused rather than ignored: a filter this stub drops is a filter the code
  under test believes it applied, which is how an ownership check that could
  never refuse passed its tests three times." ;;
        esac
        shift
    done
    [ "$ps_expect_filter" -eq 0 ] || die "ps: a filter option was given with no value"
    [ -n "$ps_want_project" ] || die "ps: no project filter given; this stub refuses a match-all listing"

    # WITHOUT -a, only running containers. Real "docker ps" defaults to running
    # only, and -a is what includes stopped ones -- measured against the daemon:
    # a stopped container in the project is returned by "ps -aq" and NOT by
    # "ps -q". Modelling that is what stops a regression from "ps -aq" to
    # "ps -q" passing here while shipping a guard blind to stopped foreign
    # containers.
    while read -r cid cproject cconfig cstate; do
        [ -n "${cid:-}" ] || continue
        [ "$cproject" = "$ps_want_project" ] || continue
        [ "$ps_all" -eq 1 ] || [ "${cstate:-running}" = "running" ] || continue
        if [ "$ps_quiet" -eq 1 ]; then
            printf '%s\n' "$cid"
        else
            printf '  %s  (%s)\n' "$cid" "$cconfig"
        fi
    done <"$root/containers" 2>/dev/null || true
    ;;
inspect)
    # A forced failure, for the other half of the fail-closed path. A container
    # can disappear between the "ps" that listed it and the "inspect" that asks
    # who owns it, and a daemon or permission error can fail the inspect alone.
    # Both must refuse, not be read as "nothing foreign".
    if [ -f "$root/inspect-status" ]; then
        printf 'Error response from daemon: no such container\n' >&2
        exit "$(cat "$root/inspect-status")"
    fi

    # The ownership check asks each container which compose file created it.
    #
    # The FORMAT STRING IS COMPARED EXACTLY, not matched as a substring. It was
    # "case $* in *config_files*", which cannot tell the real label from one
    # containing it: a key typo'd to "...config_files_TYPO" still matched, the
    # stub returned the correct value, and all 54 tests passed as the suite
    # stood then -- while real
    # docker returns empty for a label that does not exist. The stub validated
    # the format only by accident of spelling.
    #
    # Same rule as the ps arm: model it or refuse it. A format this stub does
    # not know is a question it cannot answer, and answering anyway is how the
    # previous four defects on this branch worked.
    shift
    insp_format=""
    insp_id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --format) insp_format="${2:-}"; shift 2 ;;
            --format=*) insp_format="${1#--format=}"; shift ;;
            -*) die "unsupported 'inspect' option '$1'" ;;
            *)
                [ -z "$insp_id" ] || die "inspect: more than one object named ('$insp_id' then '$1')"
                insp_id="$1"; shift ;;
        esac
    done
    [ -n "$insp_id" ] || die "inspect: no object named"

    case "$insp_format" in
        '{{index .Config.Labels "com.docker.compose.project.config_files"}}') insp_field=config ;;
        '{{index .Config.Labels "com.docker.compose.project"}}')              insp_field=project ;;
        *) die "unsupported 'inspect --format' template: ${insp_format:-<none>}. This
  stub answers exactly two, the compose project and config_files labels. A
  template it does not know is a question it cannot answer -- and a label key
  that does not exist returns EMPTY on a real daemon, which is not what
  answering anyway would produce." ;;
    esac

    while read -r cid cproject cconfig cstate; do
        [ -n "${cid:-}" ] || continue
        if [ "$cid" = "$insp_id" ]; then
            case "$insp_field" in
                config)  printf '%s\n' "$cconfig" ;;
                project) printf '%s\n' "$cproject" ;;
            esac
            exit 0
        fi
    done <"$root/containers" 2>/dev/null || true
    printf 'Error: No such object: %s\n' "$insp_id" >&2
    exit 1
    ;;
image)
    # MODELS WHETHER THE IMAGE EXISTS, and reads the template.
    #
    # It used to print "sha256:<hash of the whole argv>" unconditionally: it
    # never checked the subcommand, never read --format, and never failed. Two
    # consequences, and the second is the reason this is worth fixing.
    #
    #  1. The hash was OF THE ARGV, so it changed when an unrelated flag
    #     changed and stayed the same when the image did not -- the opposite of
    #     an image id.
    #  2. A missing image is an ERROR on a real daemon, and ImageID at
    #     netmon-stack.sh reads that error as "unknown, record an empty id"
    #     via "|| echo". While this arm could not fail, THAT BRANCH WAS
    #     UNREACHABLE FROM THE TESTS -- documented behaviour with no possible
    #     coverage (#39).
    #
    # Known images are listed in $root/images, written by the fixture from the
    # same service definitions that produce services.json, so the two cannot
    # drift. The file is REQUIRED: absent, this arm refuses rather than
    # assuming every image exists, which is the assumption it used to make.
    shift
    [ "${1:-}" = "inspect" ] || die "unsupported 'image' subcommand '${1:-<none>}'; this stub models only 'image inspect'"
    shift
    img_format=""
    img_name=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --format)   img_format="${2:-}"; shift 2 ;;
            --format=*) img_format="${1#--format=}"; shift ;;
            -*)         die "unsupported 'image inspect' option '$1'" ;;
            *)
                [ -z "$img_name" ] || die "image inspect: more than one image named ('$img_name' then '$1')"
                img_name="$1"; shift ;;
        esac
    done
    [ -n "$img_name" ] || die "image inspect: no image named"
    [ "$img_format" = '{{.Id}}' ] || die "unsupported 'image inspect --format' template: ${img_format:-<none>}. This
  stub answers exactly one, {{.Id}}. A template it does not know is a question
  it cannot answer, and answering anyway is how four defects on this stub
  worked."
    [ -f "$root/images" ] || die "image inspect: \$FAKE_DOCKER_ROOT/images does not exist, so this
  stub cannot say whether '$img_name' is present. Refusing rather than assuming
  it is: 'every image exists' is exactly the assumption this arm used to make."

    if grep -qxF "$img_name" "$root/images"; then
        # Stable per image, and a function of the IMAGE alone -- not of the
        # argv, so an unrelated flag cannot change an id.
        printf 'sha256:%s\n' "$(printf '%s' "$img_name" | sha256sum | cut -c1-64)"
        exit 0
    fi
    printf 'Error response from daemon: No such image: %s\n' "$img_name" >&2
    exit 1
    ;;
version)
    # READS THE TEMPLATE. It used to print the server version whatever it was
    # asked, so the --format string was decorative and a change to it could not
    # be detected.
    shift
    ver_format=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --format)   ver_format="${2:-}"; shift 2 ;;
            --format=*) ver_format="${1#--format=}"; shift ;;
            *)          die "unsupported 'version' argument '$1'" ;;
        esac
    done
    case "$ver_format" in
        '{{.Server.Version}}') printf '27.0.0\n' ;;
        *) die "unsupported 'version --format' template: ${ver_format:-<none>}. This stub
  answers exactly one, {{.Server.Version}}." ;;
    esac
    ;;
*) die "unsupported command: $*" ;;
esac
