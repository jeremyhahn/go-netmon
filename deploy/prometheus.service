# Prometheus unit for the go-netmon appliance: the remote-write store the poller requires; installed by make deploy.

[Unit]
Description=Prometheus time-series database (go-netmon metrics backend)
Documentation=https://prometheus.io/docs/
After=network-online.target
Wants=network-online.target

# Never stop retrying: this is the store, and an appliance without it records
# nothing at all.
StartLimitIntervalSec=0

[Service]
Type=simple
User=prometheus
Group=prometheus

ExecStart=/usr/local/bin/prometheus \
    --config.file=/etc/go-netmon/prometheus.yml \
    --storage.tsdb.path=/var/lib/prometheus \
    --storage.tsdb.retention.time=90d \
    --web.listen-address=127.0.0.1:9090 \
    --web.enable-remote-write-receiver \
    --web.enable-lifecycle

# SIGTERM lets Prometheus checkpoint the head block and close the WAL cleanly.
KillSignal=SIGTERM
TimeoutStopSec=300

Restart=always
RestartSec=10s

# Runaway guard sized for about 35k active series on a 4 GB host; raise this one if series grow.
MemoryMax=1536M
MemoryHigh=1280M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/prometheus
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
