# go-netmon web UI unit, installed by make deploy; unauthenticated, see docs/operations/security-posture.md before exposing it.

[Unit]
Description=go-netmon web UI
Documentation=https://github.com/jeremyhahn/go-netmon
After=network-online.target
Wants=network-online.target
# Not ordered against go-netmon.service: the poller waits for this service's device registry.

# Never stop retrying: the appliance is unattended and this service holds the
# only view an operator has.
StartLimitIntervalSec=0

[Service]
# Type=notify: the unit is active only after the listener is bound and READY=1 is sent.
Type=notify
NotifyAccess=main
User=go-netmon
Group=go-netmon

# The same file the poller reads. Two copies drift, and the pair disagreeing
# about default_poll_interval is how the UI came to report one interval while
# the poller used another.
Environment=CONFIG_PATH=/etc/go-netmon/config.yaml
Environment=GOMAXPROCS=4

# No WorkingDirectory: assets are embedded in the binary.
ExecStart=/usr/local/bin/go-netmon-webui \
    -listen=:8080 \
    -prometheus=http://127.0.0.1:9090 \
    -poller=http://127.0.0.1:9080 \
    -db=/var/lib/go-netmon/webui/webui.db \
    -mib-storage=/var/lib/go-netmon/poller \
    -mib-catalog=/var/lib/go-netmon/webui/mib.db

# systemctl reload re-applies the alarm rules without a restart.
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=5s

# A cold MIB catalog parse takes minutes; 900s exceeds a normal start.
TimeoutStartSec=900

# No WatchdogSec: nothing here can detect that serving stopped.

# Runaway guard; steady state is about 100 MB.
MemoryMax=512M
MemoryHigh=448M
# Locked memory for the sealed SNMP credentials; sized as for go-netmon.service.
LimitMEMLOCK=16M

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/go-netmon
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
